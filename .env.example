# StatmateAI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# =============================================================================
# APPLICATION MODE
# =============================================================================
# Options: development, production
# - development: Uses .env API keys (no user credential input required)
# - production: Users provide their own credentials via UI
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# AI MODEL API KEYS (DEV MODE ONLY)
# =============================================================================
# In PRODUCTION mode, users will enter these through the UI
# In DEVELOPMENT mode, these are used by default

# OpenAI (Required for GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Optional - for Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google/Gemini (Optional)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Groq (Optional - free fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (Optional - local models, FREE!)
# Install: https://ollama.ai
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=deepseek-r1:8b

# =============================================================================
# DEFAULT MODEL CONFIGURATION
# =============================================================================
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o
MODEL_TEMPERATURE=0.0

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://172.17.0.2:3000

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./database/statmate.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost/statmate_db

# =============================================================================
# STORAGE
# =============================================================================
DATA_DIR=./data
MAX_UPLOAD_SIZE=104857600

# =============================================================================
# SCHEDULER
# =============================================================================
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOBSTORE=memory

# =============================================================================
# SECURITY
# =============================================================================
# Generate secure random values (examples):
# python -c "import secrets, base64; print('SECRET_KEY=' + secrets.token_hex(32)); print('PASSWORD_PEPPER=' + secrets.token_hex(32)); print('EMAIL_HASH_SECRET=' + secrets.token_hex(32)); print('EMAIL_ENCRYPTION_KEY=' + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=
PASSWORD_PEPPER=
EMAIL_HASH_SECRET=
EMAIL_ENCRYPTION_KEY=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
