# Byte-compiled / optimized / DLL files
*.__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
coverage.xml
.cache
.pytest_cache/

# MyPy / Pylint
.mypy_cache/
.dmypy.json
.pyre/

# Jupyter Notebook
.ipynb_checkpoints

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Logs
*.log

# uv cache
.uv/

# Environment variables (NEVER commit API keys!)
.env
.env.local
.env.*.local
.env.devcontainer
.dev.secrets.env

# Database (local development)
database/statmate.db
database/statmate.db-*

# Data directories (user uploads and results)
# Ignore all files but keep directory structure with .gitkeep
data/uploads/*
!data/uploads/.gitkeep
# Include sample/demo datasets for testing
!data/uploads/sample_categorical_20250103_150000.parquet
!data/uploads/sample_continuous_paired_20250101_120000.parquet
data/results/*
!data/results/.gitkeep
data/logs/*
!data/logs/.gitkeep

tmp_*

