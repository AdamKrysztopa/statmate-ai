# StatmateAI Environment Configuration

# Application
APP_NAME=StatmateAI
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./database/statmate.db
DATABASE_ECHO=False

# Storage
DATA_DIR=./data
MAX_UPLOAD_SIZE=104857600

# OpenAI - ADD YOUR KEY HERE
OPENAI_API_KEY=sk-placeholder-add-your-real-key-here

# Security
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOBSTORE=memory
