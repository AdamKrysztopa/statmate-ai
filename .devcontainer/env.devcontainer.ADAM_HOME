# ============================================================================
# ADAM'S HOME/PRIMARY MACHINE CONFIGURATION (from origin/fixes_local_dev_container)
# ============================================================================
# This is for your HOME/PRIMARY machine where this repo is your main one
# Copy this file to PROJECT_ROOT/.env.devcontainer
# ============================================================================

# Git Configuration (from origin/fixes_local_dev_container)
GIT_USER_NAME=Adam Krysztopa
GIT_USER_EMAIL=krysztopa@gmail.com

# OpenAI API Key (REPLACE WITH YOUR ACTUAL KEY!)
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# NO SSH_KEY_NAME needed for home setup!
# The entire .ssh directory will be mounted

# ============================================================================
# IMPORTANT: When using this configuration, you must also:
# ============================================================================
# 1. Update .devcontainer/devcontainer.json
# 2. Change the "mounts" section from:
#    "mounts": [
#        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/${localEnv:SSH_KEY_NAME},target=/home/vscode/.ssh/${localEnv:SSH_KEY_NAME},type=bind,consistency=cached",
#        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/${localEnv:SSH_KEY_NAME}.pub,target=/home/vscode/.ssh/${localEnv:SSH_KEY_NAME}.pub,type=bind,consistency=cached"
#    ],
# 
# 3. To this (see the commented section in devcontainer.json):
#    "mounts": [
#        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
#    ],
# 
# 4. Then rebuild container
# ============================================================================

# ============================================================================
# INSTRUCTIONS:
# 1. Replace 'sk-your-actual-openai-api-key-here' with your real API key
# 2. Update devcontainer.json mounts (see above)
# 3. Copy this file: cp .devcontainer/env.devcontainer.ADAM_HOME .env.devcontainer
# 4. Source it: source .env.devcontainer
# 5. Open VS Code: code .
# 6. Rebuild Container (since you changed devcontainer.json)
# ============================================================================

