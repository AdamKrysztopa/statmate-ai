# ============================================================================
# DEVCONTAINER ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to PROJECT_ROOT/.env.devcontainer and fill in your values
# (NOT in .devcontainer folder - it must be in the project root!)
# 
# IMPORTANT: .env.devcontainer is in .gitignore - NEVER commit it!
# ============================================================================

# ----------------------------------------------------------------------------
# CURRENT SETUP (origin/fixes style - with specific SSH key mounting)
# ----------------------------------------------------------------------------
# This is the recommended setup if you're working from a secondary repo
# or need explicit SSH key configuration

# Git Configuration
GIT_USER_NAME=Adam Krysztopa
GIT_USER_EMAIL=krysztopa@gmail.com

# SSH Key Name (the name of your private key file in ~/.ssh/)
# This will be mounted into the container
SSH_KEY_NAME=adam_private_gh

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----------------------------------------------------------------------------
# ALTERNATIVE SETUP (origin/fixes_local_dev_container style)
# ----------------------------------------------------------------------------
# Uncomment these if you're working from your primary machine where
# this repo is your main one. This approach doesn't mount specific SSH keys.
# 
# NOTE: If using this approach, you need to:
# 1. Comment out the SSH_KEY_NAME above
# 2. Update devcontainer.json to remove SSH mounts  
# 3. Rely on Git credential helper or different SSH setup

# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=your.email@example.com
# OPENAI_API_KEY=sk-your-openai-api-key-here
# # No SSH_KEY_NAME needed for this setup

# ============================================================================

