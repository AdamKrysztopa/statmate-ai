# ============================================================================
# DEVCONTAINER ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to PROJECT_ROOT/.env.devcontainer and fill in your values
# 
#   cp .devcontainer/env.devcontainer.example .env.devcontainer
#   nano .env.devcontainer
# 
# Location: /workspaces/statmate-ai/.env.devcontainer (at project root!)
#          NOT in the .devcontainer/ folder
# 
# IMPORTANT: .env.devcontainer is in .gitignore - NEVER commit it!
# ============================================================================

# ----------------------------------------------------------------------------
# GIT CONFIGURATION
# ----------------------------------------------------------------------------
# Your git identity for commits and pushes
# Replace with YOUR name and email

GIT_USER_NAME=Your Name Here
GIT_USER_EMAIL=your.email@example.com

# ----------------------------------------------------------------------------
# SSH CONFIGURATION
# ----------------------------------------------------------------------------
# The name of your SSH private key file in ~/.ssh/
# Common examples: id_rsa, id_ed25519, github_key, adam_private_gh, etc.
# 
# To find your SSH key:
#   ls -la ~/.ssh/
# 
# Look for private key files (without .pub extension)

SSH_KEY_NAME=id_rsa

# ----------------------------------------------------------------------------
# API KEYS
# ----------------------------------------------------------------------------
# Your OpenAI API key for AI features
# Get yours at: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. After creating .env.devcontainer, rebuild your container:
#    Ctrl+Shift+P → "Dev Containers: Rebuild Container"
# 
# 2. The setup scripts will automatically load these values
# 
# 3. Never commit .env.devcontainer to git (it's already in .gitignore)
# 
# 4. Each developer should have their own .env.devcontainer
# 
# ============================================================================

