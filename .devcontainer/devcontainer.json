{
    "name": "statmate-ai",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "VARIANT": "3.11.12"
        }
    },
    "runArgs": [
        "--rm",
        "--name=statmate-ai_devcontainer"
    ],
    // =========================================================================
    // SSH MOUNT CONFIGURATION - Choose one approach:
    // =========================================================================
    // 
    // APPROACH 1 (origin/fixes style): Mount specific SSH key
    // Use when: Working from secondary repo, need specific SSH key
    // Required: Set SSH_KEY_NAME in .env.devcontainer (e.g., SSH_KEY_NAME=adam_private_gh)
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],
    //
    // APPROACH 2 (origin/fixes_local_dev_container style): Mount entire .ssh directory
    // Use when: This is your primary machine/repo
    // Required: Just GIT_USER_NAME and GIT_USER_EMAIL in .env.devcontainer
    // To use this approach, REPLACE the "mounts" above with:
    // "mounts": [
    //     "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    // ],
    // =========================================================================
    "remoteUser": "vscode",
    "containerEnv": {
        "HOME": "/home/vscode",
        "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
        "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}",
        "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
        "SSH_KEY_NAME": "${localEnv:SSH_KEY_NAME:id_rsa}"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll": true,
                        "source.organizeImports": true
                    }
                },
                "python.languageServer": "Pylance",
                "python.analysis.extraPaths": [
                    "${workspaceFolder}/.venv/lib/python3.11/site-packages"
                ],
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
                    "editor.formatOnSave": true
                },
                "[json]": {
                    "editor.formatOnSave": true
                },
                "[toml]": {
                    "editor.defaultFormatter": "tamasfe.even-better-toml"
                },
                "[shellscript][ignore][hosts]": {
                    "editor.defaultFormatter": "foxundermoon.shell-format",
                    "editor.formatOnSave": true
                },
                "eslint.format.enable": false
            },
            "extensions": [
                "ms-python.python",
                "emeraldwalk.runonsave",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-toolsai.jupyter",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one",
                "foxundermoon.shell-format",
                "github.copilot"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup_git.sh && bash .devcontainer/setup_ssh.sh && git config --global core.editor \"code --wait --new-window\"",
    "shutdownAction": "stopContainer"
}