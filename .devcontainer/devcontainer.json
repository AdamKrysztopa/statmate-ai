{
    "name": "statmate-ai",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "VARIANT": "3.11.12",
            "GIT_USER_NAME": "Adam Krysztopa",
            "GIT_USER_EMAIL": "krysztopa@gmail.com",
            "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"

        }
    },
    "runArgs": [
        "--rm",
        "--name=statmate-ai_devcontainer"
    ],
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/adam_private_gh,target=/home/vscode/.ssh/adam_private_gh,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/adam_private_gh.pub,target=/home/vscode/.ssh/adam_private_gh.pub,type=bind,consistency=cached"
    ],
    "remoteUser": "vscode",
    "containerEnv": {
        "MY_ENV_VAR": "${localEnv:MY_ENV_VAR}",
        "HOME": "/home/vscode",
        "GIT_USER_NAME": "Adam Krysztopa",
        "GIT_USER_EMAIL": "krysztopa@gmail.com",
        "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"

    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll": true,
                        "source.organizeImports": true
                    }
                },
                "python.languageServer": "Pylance",
                "python.analysis.extraPaths": ["${workspaceFolder}/.venv/lib/python3.11/site-packages"],
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
                    "editor.formatOnSave": true
                },
                "[json]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.formatOnSave": true
                },
                "[toml]": {
                    "editor.defaultFormatter": "tamasfe.even-better-toml"
                },
                "[shellscript][ignore][hosts]": {
                    "editor.defaultFormatter": "foxundermoon.shell-format",
                    "editor.formatOnSave": true
                },
                "eslint.format.enable": true
            },
            "extensions": [
                "ms-python.python",
                "emeraldwalk.runonsave",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-toolsai.jupyter",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one",
                "esbenp.prettier-vscode",
                "foxundermoon.shell-format",
                "github.copilot"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup_git.sh && bash .devcontainer/setup_ssh.sh && uv sync && git config --global core.editor \"code --wait --new-window\"",
    "shutdownAction": "stopContainer"
}