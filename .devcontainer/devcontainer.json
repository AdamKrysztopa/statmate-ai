{
    "name": "statmate-ai-unified",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "VARIANT": "3.11.12",
            // Pass the API key during the build (if needed by build scripts)
            "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
        }
    },
    "runArgs": [
        "--rm",
        "--name=statmate-ai_devcontainer"
    ],
    "mounts": [
        // Mount the project-specific SSH key.
        // The path is read from the host's PROJECT_SSH_KEY_PATH variable.
        "source=${localEnv:PROJECT_SSH_KEY_PATH},target=/home/vscode/.ssh/project_key,type=bind,consistency=cached",
        "source=${localEnv:PROJECT_SSH_KEY_PATH}.pub,target=/home/vscode/.ssh/project_key.pub,type=bind,consistency=cached"
    ],
    "remoteUser": "vscode",
    "containerEnv": {
        // Pass host variables into the container for the post-create script
        "DEV_ENV_TYPE": "${localEnv:DEV_ENV_TYPE}",
        "PROJECT_GIT_USER_NAME": "${localEnv:PROJECT_GIT_USER_NAME}",
        "PROJECT_GIT_USER_EMAIL": "${localEnv:PROJECT_GIT_USER_EMAIL}",
        "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
        "HOME": "/home/vscode"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll": true,
                        "source.organizeImports": true
                    }
                },
                "python.languageServer": "Pylance",
                "python.analysis.extraPaths": ["${workspaceFolder}/.venv/lib/python3.11/site-packages"],
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml"
                },
                "[markdown]": {
                    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
                },
                "[json]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[toml]": {
                    "editor.defaultFormatter": "tamasfe.even-better-toml"
                },
                "[shellscript][ignore][hosts]": {
                    "editor.defaultFormatter": "foxundermoon.shell-format"
                }
            },
            "extensions": [
                "ms-python.python",
                "emeraldwalk.runonsave",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-toolsai.jupyter",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one",
                "esbenp.prettier-vscode",
                "foxundermoon.shell-format",
                "github.copilot",
                "bierner.markdown-mermaid",
                "shd101wyy.markdown-preview-enhanced"
            ]
        }
    },
    // This single script now handles all setup logic
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "shutdownAction": "stopContainer"
}

