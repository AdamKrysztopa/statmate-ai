{
    "name": "statmate-ai",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "VARIANT": "3.11.12"
        }
    },
    "runArgs": [
        "--rm",
        "--name=statmate-ai_devcontainer"
    ],
    // =========================================================================
    // SSH MOUNT CONFIGURATION
    // =========================================================================
    // Mounts your entire ~/.ssh directory into the container
    // All configuration (git, SSH keys) is handled via .env.devcontainer file
    // 
    // Required setup:
    // 1. Copy .devcontainer/env.devcontainer.example to .env.devcontainer (at project root)
    // 2. Fill in your values in .env.devcontainer:
    //    - GIT_USER_NAME
    //    - GIT_USER_EMAIL  
    //    - SSH_KEY_NAME (e.g., id_rsa, adam_private_gh, etc.)
    //    - OPENAI_API_KEY
    // =========================================================================
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],
    "remoteUser": "vscode",
    "containerEnv": {
        "HOME": "/home/vscode"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll": true,
                        "source.organizeImports": true
                    }
                },
                "python.languageServer": "Pylance",
                "python.analysis.extraPaths": [
                    "${workspaceFolder}/.venv/lib/python3.11/site-packages"
                ],
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
                    "editor.formatOnSave": true
                },
                "[json]": {
                    "editor.formatOnSave": true
                },
                "[toml]": {
                    "editor.defaultFormatter": "tamasfe.even-better-toml"
                },
                "[shellscript][ignore][hosts]": {
                    "editor.defaultFormatter": "foxundermoon.shell-format",
                    "editor.formatOnSave": true
                },
                "eslint.format.enable": false
            },
            "extensions": [
                "ms-python.python",
                "emeraldwalk.runonsave",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-toolsai.jupyter",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one",
                "foxundermoon.shell-format",
                "github.copilot"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup_git.sh && bash .devcontainer/setup_ssh.sh && git config --global core.editor \"code --wait --new-window\"",
    "shutdownAction": "stopContainer"
}