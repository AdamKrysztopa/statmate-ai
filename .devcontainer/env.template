# DevContainer Environment Variables Template
# Copy these to your shell profile (~/.bashrc, ~/.zshrc, etc.)

# Git Configuration (Required)
export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="your.email@example.com"

# SSH Configuration (Optional - defaults to 'id_rsa' if not set)
export SSH_KEY_NAME="id_rsa"

# API Keys (Required)
export OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional
export MY_ENV_VAR="your-value"

